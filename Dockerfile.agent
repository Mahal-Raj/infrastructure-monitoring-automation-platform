FROM python:3.13-slim

RUN useradd --system --uid 10001 --create-home infra-agent
WORKDIR /opt/infra-agent
COPY --chown=infra-agent:infra-agent agent/infra_agent.py ./infra_agent.py
USER 10001
EXPOSE 9100
HEALTHCHECK --interval=10s --timeout=3s --retries=5 CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:9100/health', timeout=2).read()"]
ENTRYPOINT ["python", "/opt/infra-agent/infra_agent.py"]
