# Controller
OPERATOR_TOKEN=replace-with-a-generated-operator-token
AGENT_TOKEN_EAST=replace-with-a-generated-node-token
AGENT_TOKEN_WEST=replace-with-a-different-generated-node-token
POLL_INTERVAL_SECONDS=30

# Agent
AGENT_TOKEN=replace-with-the-token-for-this-node
MONITORED_SERVICES=nginx,ssh
MONITORED_ENDPOINTS=controller=http://127.0.0.1:8080/api/v1/health
MANAGED_SERVICES=nginx,ssh
LOG_UNITS=nginx,ssh
ALLOW_MUTATIONS=false
